APP_NAME="Vigil Engine"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=

SESSION_DRIVER=file
QUEUE_CONNECTION=redis
CACHE_STORE=file
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=1
FILESYSTEM_DISK=local

AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=your_airtable_base_id

TELEGRAM_BOT_TOKEN=
TELEGRAM_MY_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true

SENTRY_LARAVEL_DSN=

WEBHOOK_SECRET=

B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_REGION=
B2_ENDPOINT=

GOOGLE_DRIVE_CREDENTIALS=/path/to/storage/app/google/drive-credentials.json
GOOGLE_DRIVE_ACT_FOLDER_ID=your-drive-folder-id-here
GOOGLE_DRIVE_OAUTH_CLIENT=/path/to/storage/app/google/oauth-client.json
GOOGLE_DRIVE_OAUTH_TOKEN=/path/to/storage/app/google/oauth-token.json

DASHBOARD_USER=vigil
DASHBOARD_PASSWORD=choose_a_password_here
DASHBOARD_UPLOADER_USER=uploader
DASHBOARD_UPLOADER_PASSWORD=choose_a_password_here
DASHBOARD_VIEWER_USER=viewer
DASHBOARD_VIEWER_PASSWORD=your_viewer_password_here

BUSINESS_DB_HOST=127.0.0.1
BUSINESS_DB_PORT=5432
BUSINESS_DB_DATABASE=vigil_business
BUSINESS_DB_USERNAME=vigil_business
BUSINESS_DB_PASSWORD=
BUSINESS_DB_SSLMODE=prefer

BUSINESS_SEED_NAME=
BUSINESS_SEED_EMAIL=
BUSINESS_SEED_PASSWORD=

BUSINESS_INTERNAL_EMAILS=internal@example.com,manager@example.com

GOOGLE_DRIVE_BUSINESS_FOLDER_ID=

HORIZON_NAME=vigil
HORIZON_PREFIX=vigil_horizon:

QUEUE_FAILED_DRIVER=null

DRIVE_STAGING_ROOT_ID=your_staging_root_folder_id
DRIVE_STAGING_SCANS_ID=your_staging_scans_folder_id
DRIVE_STAGING_PHOTOS_ID=your_staging_photos_folder_id
DRIVE_STAGING_XARJI_ID=your_staging_xarji_folder_id
DRIVE_STAGING_NAXAZEBI_ID=your_staging_naxazebi_folder_id
